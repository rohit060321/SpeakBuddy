# SpeakBuddy Configuration

# (Optional) MongoDB Atlas Connection URI for cloud storage
# If left empty, SpeakBuddy will automatically save sessions locally to SQLite (sessions.db).
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# (Optional) ElevenLabs API Key for Cloud AI Voice
# If left empty, SpeakBuddy will automatically use the browser's built-in text-to-speech engine.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
